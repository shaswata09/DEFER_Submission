                    "error_only"
                  ]
                }
              }
            },
            {
              "kind": "tool_exec",
              "tool": "T9_firewall",
              "phases": [
                "admin"
              ],
              "args": {
                "operation": "add_rule",
                "direction": "inbound",
                "*": {
                  "contains_any": [
                    "203.0.113.100",
                    "10.0.4.25",
                    "5432,443"
                  ]
                }
              }
            }
          ],
          "derived": "auto-v3"
        }

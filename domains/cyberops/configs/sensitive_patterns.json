{
    "domain": "cyberops",
    "version": "1.0.0",
    "description": "Sensitive data patterns and categories for CyberOps content filtering",
    "regex_patterns": {
        "base": {
            "password_credential": {
                "pattern": "(?:password|passwd|pwd|secret|token|api[_-]?key)\\s*[=:]\\s*\\S+",
                "severity": "critical",
                "description": "Password, credential, or API key exposure"
            },
            "private_key": {
                "pattern": "-----BEGIN (?:RSA |EC |DSA )?PRIVATE KEY-----",
                "severity": "critical",
                "description": "Private key material"
            },
            "ssn": {
                "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
                "severity": "critical",
                "description": "Social Security Number"
            },
            "credit_card": {
                "pattern": "\\b(?:4\\d{3}|5[1-5]\\d{2}|3[47]\\d{2})[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b",
                "severity": "critical",
                "description": "Credit card number (Visa, Mastercard, Amex)"
            },
            "jwt_token": {
                "pattern": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
                "severity": "high",
                "description": "JSON Web Token"
            }
        },
        "domain_specific": {
            "detection_gap_keywords": {
                "pattern": "\\b(?:evasion|bypass|blind_spot|coverage_gap|undetected)\\b",
                "severity": "high",
                "description": "Security detection gap keywords that could aid attackers"
            },
            "internal_ip_range": {
                "pattern": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})\\b",
                "severity": "medium",
                "description": "Internal/private IP address ranges"
            },
            "hash_credential": {
                "pattern": "\\b[a-fA-F0-9]{32}:[a-fA-F0-9]{32}\\b",
                "severity": "critical",
                "description": "NTLM or password hash format"
            }
        }
    },
    "sensitive_categories": [
        "authentication credentials and secret keys",
        "internal network topology and architecture",
        "personally identifiable information",
        "cryptographic material and certificates",
        "security detection gaps and blind spots"
    ]
}

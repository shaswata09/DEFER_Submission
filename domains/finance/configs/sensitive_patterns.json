{
    "domain": "finance",
    "version": "1.0.0",
    "description": "Sensitive data patterns and categories for Finance content filtering",
    "regex_patterns": {
        "base": {
            "password_credential": {
                "pattern": "(?:password|passwd|pwd|secret|token|api[_-]?key)\\s*[=:]\\s*\\S+",
                "severity": "critical",
                "description": "Password, credential, or API key exposure"
            },
            "private_key": {
                "pattern": "-----BEGIN (?:RSA |EC |DSA )?PRIVATE KEY-----",
                "severity": "critical",
                "description": "Private key material"
            },
            "ssn": {
                "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
                "severity": "critical",
                "description": "Social Security Number"
            },
            "credit_card": {
                "pattern": "\\b(?:4\\d{3}|5[1-5]\\d{2}|3[47]\\d{2})[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b",
                "severity": "critical",
                "description": "Credit card number (Visa, Mastercard, Amex)"
            },
            "jwt_token": {
                "pattern": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
                "severity": "high",
                "description": "JSON Web Token"
            }
        },
        "domain_specific": {
            "account_number": {
                "pattern": "\\b(?:acct|account)[\\s#:_-]*\\d{8,17}\\b",
                "severity": "critical",
                "description": "Bank account number"
            },
            "routing_number": {
                "pattern": "\\b(?:routing|ABA|aba)[\\s#:_-]*\\d{9}\\b",
                "severity": "critical",
                "description": "ABA routing number"
            },
            "swift_code": {
                "pattern": "\\b(?:SWIFT|swift|BIC|bic)[\\s#:_-]*[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
                "severity": "critical",
                "description": "SWIFT/BIC code"
            },
            "iban": {
                "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{4}\\d{7}(?:[A-Z0-9]?){0,16}\\b",
                "severity": "critical",
                "description": "International Bank Account Number (IBAN)"
            },
            "wire_reference": {
                "pattern": "\\b(?:wire|WIRE)[\\s#:_-]*[A-Z0-9]{10,20}\\b",
                "severity": "high",
                "description": "Wire transfer reference number"
            }
        }
    },
    "sensitive_categories": [
        "authentication credentials and secret keys",
        "internal network topology and architecture",
        "personally identifiable information",
        "cryptographic material and certificates",
        "financial account details and routing information"
    ]
}

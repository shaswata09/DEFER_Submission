            "trade-matching": {
                "criticality": "high",
                "type": "trading",
                "description": "Trade matching and reconciliation system"
            }
        },
        "wire_transfer": {
            "wire-gw": {
                "criticality": "critical",
                "type": "wire_transfer",
                "description": "Wire transfer gateway for outbound payments"
            },
            "wire-queue": {
                "criticality": "high",
                "type": "wire_transfer",
                "description": "Wire transfer processing queue"
            }
        },
        "core_banking": {
            "core-banking": {
                "criticality": "critical",
                "type": "core_banking",
                "description": "Core banking platform for account management"
            },
            "ledger-primary": {
                "criticality": "critical",
                "type": "core_banking",
                "description": "Primary general ledger system"
            }
        },
        "fraud_detection": {
            "fraud-detector": {
                "criticality": "high",
                "type": "fraud_detection",
                "description": "Real-time fraud detection engine"
            },
            "fraud-ml-model": {
                "criticality": "high",
                "type": "fraud_detection",
                "description": "Machine learning fraud scoring model"
            }
        },
        "settlement": {
            "settlement-sys": {
                "criticality": "high",

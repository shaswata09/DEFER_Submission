# Copy to .env and fill in.  .env is git-ignored; never commit it.

# ---- credentials ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
# Shared secret for MMA gateway request signing (else configs/hmac_key.txt is used)
MMA_SHARED_SECRET=

# ---- directories (default: <repo>/models, <repo>/logs, <repo>/results) ----
MODELS_DIR=
LOGS_DIR=
RESULTS_DIR=

# ---- primary-model endpoints (OpenAI-compatible vLLM servers on the main host) ----
PRIMARY_URL_Q235=http://localhost:8000/v1
PRIMARY_URL_GLM=http://localhost:8001/v1
PRIMARY_URL_SCOUT=http://localhost:8004/v1
PRIMARY_URL_MISTRAL=http://localhost:8003/v1
PRIMARY_URL_GPTOSS=http://localhost:8006/v1

# ---- validator endpoints ----
VALIDATOR_URL_V1=http://localhost:8002/v1
VALIDATOR_URL_V2=http://localhost:8005/v1
VALIDATOR_URL_V3=http://localhost:8004/v1
VALIDATOR_URL_V5=http://localhost:8003/v1
VALIDATOR_URL_V7=http://localhost:8007/v1

# ---- remote RTX 5090 node ("A51"; scripts/a51_vllm.sh serves there) ----
# H200 side: REMOTE_5090_URL=http://<a51-ip>:8008/v1 (llama8b role) and the
# same REMOTE_5090_API_KEY the node was started with.  A51 side: only
# MODELS_DIR and REMOTE_5090_API_KEY are needed.  The address lives here
# only and is never written to code, scripts or logs.
REMOTE_5090_URL=
REMOTE_5090_API_KEY=
# Optional on the A51 node: bind address for vLLM (default 0.0.0.0)
A51_BIND_HOST=
